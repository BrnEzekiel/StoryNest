{
  "expo": {
    "name": "StoryNest",
    "slug": "mobile",
    "jsEngine": "hermes",
    "version": "1.0.8",
    "scheme": "storynest",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#003631"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.storynest.mobile",
      "buildNumber": "7"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#003631"
      },
      "package": "com.storynest.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 10,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "REQUEST_INSTALL_PACKAGES",
        "RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "storynest.app",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8a588efb-64b8-4d60-9e9b-205403b2b363"
      },
      "apiUrl": "https://storynest-qzwm.onrender.com"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a588efb-64b8-4d60-9e9b-205403b2b363",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "owner": "brnezekiel",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FFEDA8",
          "sounds": [
            "./assets/notification.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "targetSdkVersion": 34,
            "compileSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "@react-native-voice/voice"
    ]
  }
}
