{
  "expo": {
    "name": "StoryNest",
    "slug": "mobile",
    "jsEngine": "hermes",
    "version": "1.0.0",
    "scheme": "storynest",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#003631"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.storynest.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#003631"
      },
      "package": "com.storynest.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8a588efb-64b8-4d60-9e9b-205403b2b363"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a588efb-64b8-4d60-9e9b-205403b2b363"
    },
    "owner": "brnezekiel",
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sqlite"
    ]
  }
}
