# --- BACKEND ---
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/storynest?schema=public"
JWT_ACCESS_SECRET="your_jwt_access_secret"
JWT_REFRESH_SECRET="your_jwt_refresh_secret"

# Redis (required for BullMQ workers / queues)
REDIS_URL="redis://127.0.0.1:6379"

# Cloudinary (for cover images)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Google Auth & Gmail API
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REFRESH_TOKEN="your_refresh_token"
SMTP_USER="your_gmail_address"

# Optional Slack notifications
# SLACK_WEBHOOK_URL=

# --- PAYSTACK (Nest Plus) — put real keys only in local .env / host secrets, NEVER commit ---
# Dashboard: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_or_live_xxx"
# Public key is safe for the browser (web):
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_or_live_xxx"
# Amount in smallest unit (e.g. kobo for NGN). Example: 1000000 = ₦10,000.00
NEST_PLUS_AMOUNT="1000000"
NEST_PLUS_CURRENCY="NGN"

# --- WEB (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:5000"
# Optional server-side API URL for verify → activate
API_URL="http://localhost:5000"

# --- MOBILE ---
EXPO_PUBLIC_API_URL="http://localhost:5000"
