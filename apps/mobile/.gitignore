# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders (android/ IS tracked: it carries hand-fixed native
# code that prebuild would wipe; only build outputs and local paths stay out)
/ios
/android/.gradle/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/captures/
/android/local.properties
/android/*.hprof
/android/app/src/main/assets/index.android.bundle
