# --- BACKEND ---
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/storynest?schema=public"
JWT_ACCESS_SECRET="your_jwt_access_secret"
JWT_REFRESH_SECRET="your_jwt_refresh_secret"

# Redis (required for BullMQ workers / queues)
# Local: redis://127.0.0.1:6379
# Upstash / managed: rediss://default:PASSWORD@HOST:6379
REDIS_URL="redis://127.0.0.1:6379"

# Cloudinary (for cover images)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Google Auth & Gmail API (Port 443 — Use this for Render)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REFRESH_TOKEN="your_refresh_token"
SMTP_USER="your_gmail_address"

# Optional Slack notifications
# SLACK_WEBHOOK_URL=

# --- MOBILE ---
# Android: http://10.0.2.2:5000, iOS: http://localhost:5000
EXPO_PUBLIC_API_URL="http://localhost:5000"
